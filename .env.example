# Vantage connection used by the data-loading script
TD_HOST=your-vantage-host
TD_USER=your-loader-user
TD_PASSWORD=your-loader-password

# LLM endpoint or path
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=local
LLM_MODEL=your-model-name

# TD MCP configuration
DATABASE_URI=teradata://TD_USER:TD_PASSWORD@TD_HOST:1025/database
LOGMECH=TD2
PROFILE=base
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_URL=http://localhost:8001/mcp